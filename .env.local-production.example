# Copy to .env.local-production. This file is only for local production-mode
# simulation. Do not use real production secrets or a real production database.
LOCAL_HTTP_PORT=8088

# The API writes judge files here, and the Docker daemon mounts the same path
# into short-lived compiler/runtime containers. On a Linux server this must be
# an absolute Linux path.
JUDGE_WORK_DIR=/tmp/gojo-judge

MYSQL_DATABASE=gojo_local
MYSQL_USER=gojo
MYSQL_PASSWORD=change-this-local-mysql-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password
GOJO_SQL_DSN=gojo:change-this-local-mysql-password@tcp(mysql:3306)/gojo_local?charset=utf8mb4&parseTime=True&loc=Local

# Generate distinct local values, each at least 32 characters long.
GOJO_JWT_SECRET=replace-with-a-local-random-secret-at-least-32-characters
REDIS_PASSWORD=replace-with-a-local-random-secret-at-least-32-characters
AGENT_SERVICE_TOKEN=replace-with-a-local-random-secret-at-least-32-characters

# Used only by the one-time bootstrap-admin tool. Use 3-32 characters for the
# username and a 12-72 byte password. Clear the password after bootstrapping.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Docker Desktop normally accepts 0. On Linux set this to:
# stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
