# Local development. Go and Python run on the host.
APP_ENV=dev

# Docker MySQL. Match these values in config/config.dev.yaml's sql.dsn.
MYSQL_DATABASE=gojo
MYSQL_USER=gojo
MYSQL_PASSWORD=replace-with-a-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# Python agent
AGENT_SERVICE_TOKEN=
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
GO_BACKEND_BASE_URL=http://127.0.0.1:8080
AGENT_DEBUG=true
AGENT_LLM_TIMEOUT_SECONDS=120

# Embedding / RAG
DASHSCOPE_API_KEY=your_dashscope_api_key_here
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
QDRANT_URL=http://127.0.0.1:6333
MEMORY_COLLECTION=chat_memories
MEMORY_TOP_K=3

# Optional
EXPORT_API_TOKEN=

# Redis (must match redis.password in config/config.dev.yaml)
REDIS_PASSWORD=replace-with-a-long-random-password
