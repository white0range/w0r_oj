# Environment: use prod or production for a real deployment. It enables strict secret checks.
APP_ENV=dev

# Python agent
AGENT_SERVICE_TOKEN=
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
GO_BACKEND_BASE_URL=http://host.docker.internal:8080
AGENT_DEBUG=true
AGENT_LLM_TIMEOUT_SECONDS=120

# Embedding / RAG
DASHSCOPE_API_KEY=your_dashscope_api_key_here
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
QDRANT_URL=http://qdrant:6333
MEMORY_COLLECTION=chat_memories
MEMORY_TOP_K=3

# Optional
EXPORT_API_TOKEN=

# Redis (must match redis.password in the Go production config)
REDIS_PASSWORD=replace-with-a-long-random-password
